								]
							}
						],
						"policy": {
							"retry": 0,
							"retryIntervalInSeconds": 30,
							"secureOutput": false,
							"secureInput": false
						},
						"userProperties": [],
						"typeProperties": {
							"notebookPath": "/Users/ghazalajamal202@gmail.com/Shared/retail-analytics/03_aggregate_gold",
							"baseParameters": {
								"loadDate": {
									"value": "@pipeline().parameters.loadDate",
									"type": "Expression"
								}
							}
						},
						"linkedServiceName": {
							"referenceName": "LS_Databricks_RetailLake",
							"type": "LinkedServiceReference"
						}
					},
					{
						"name": "Data_Quality_Report",
						"type": "DatabricksNotebook",
						"dependsOn": [
							{
								"activity": "Aggregate_to_Gold",
								"dependencyConditions": [
									"Succeeded"
								]
							}
						],
						"policy": {
							"retry": 0,
							"retryIntervalInSeconds": 30,
							"secureOutput": false,
							"secureInput": false
						},
						"userProperties": [],
						"typeProperties": {
							"notebookPath": "/Users/ghazalajamal202@gmail.com/Shared/retail-analytics/04_dq_report",
							"baseParameters": {
								"loadDate": {
									"value": "@pipeline().parameters.loadDate",
									"type": "Expression"
								}
							}
						},
						"linkedServiceName": {
							"referenceName": "LS_Databricks_RetailLake",
							"type": "LinkedServiceReference"
						}
					},
					{
						"name": "Notify_On_Failure",
						"type": "WebActivity",
						"dependsOn": [
							{
								"activity": "Data_Quality_Report",
								"dependencyConditions": [
									"Failed"
								]
							}
						],
						"policy": {
							"retry": 0,
							"retryIntervalInSeconds": 30,
							"secureOutput": false,
							"secureInput": false
						},
						"userProperties": [],
						"typeProperties": {
							"method": "POST",
							"headers": {},
							"url": "https://prod-00.westus.logic.azure.com/workflows/retail-alerts/invoke",
							"body": {
								"pipeline": "PL_Transform_Bronze_to_Silver_Gold",
								"status": "Failed"
							}
						}
					}
				],
				"policy": {
					"elapsedTimeMetric": {}
				},
				"parameters": {
