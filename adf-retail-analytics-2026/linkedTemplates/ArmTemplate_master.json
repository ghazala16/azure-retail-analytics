{
	"$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
	"contentVersion": "1.0.0.0",
	"parameters": {
		"factoryName": {
			"type": "string",
			"metadata": "Data Factory name",
			"defaultValue": "adf-retail-analytics-2026"
		},
		"LS_ADLSGen2_RetailLake_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://retailanalytics.dfs.core.windows.net"
		},
		"LS_Databricks_RetailLake_properties_typeProperties_existingClusterId": {
			"type": "string",
			"defaultValue": "0817-104607-m6y13nvf"
		},
		"LS_KeyVault_RetailLake_properties_typeProperties_baseUrl": {
			"type": "string",
			"defaultValue": "https://kv-retail-analytics.vault.azure.net/"
		},
		"LS_REST_DummyJSON_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://dummyjson.com/c/8982-38dc-4f32-831d"
		},
		"LS_SFTP_POSSource_properties_typeProperties_host": {
			"type": "string",
			"defaultValue": "retailanalytics.blob.core.windows.net"
		},
		"LS_SFTP_POSSource_properties_typeProperties_hostKeyFingerprint": {
			"type": "string",
			"defaultValue": "ecdsa-sha2-nistp256 256 5b:cc:86:7b:0d:ee:c6:4b:92:f5:8e:47:74:a3:0c:ff"
		},
		"LS_SFTP_POSSource_properties_typeProperties_userName": {
			"type": "string",
			"defaultValue": "retailanalytics.sftpuser"
		},
		"containerUri": {
			"type": "string",
			"metadata": "URI to storage account containing linked ARM templates"
		},
		"containerSasToken": {
			"type": "string",
			"metadata": "Sas token to storage account containing linked ARM templates"
		}
	},
	"variables": {
		"factoryId": "[concat('Microsoft.DataFactory/factories/', parameters('factoryName'))]"
	},
	"resources": [
		{
			"name": "adf-retail-analytics-2026_ArmTemplate_0",
			"type": "Microsoft.Resources/deployments",
			"apiVersion": "2024-03-01",
			"properties": {
				"mode": "incremental",
				"templateLink": {
					"uri": "[concat(parameters('containerUri'), '/ArmTemplate_0.json', parameters('containerSasToken'))]",
					"contentVersion": "1.0.0.0"
				},
				"parameters": {
					"factoryName": {
						"value": "[parameters('factoryName')]"
					},
					"LS_KeyVault_RetailLake_properties_typeProperties_baseUrl": {
						"value": "[parameters('LS_KeyVault_RetailLake_properties_typeProperties_baseUrl')]"
					},
					"LS_REST_DummyJSON_properties_typeProperties_url": {
						"value": "[parameters('LS_REST_DummyJSON_properties_typeProperties_url')]"
					},
					"LS_ADLSGen2_RetailLake_properties_typeProperties_url": {
						"value": "[parameters('LS_ADLSGen2_RetailLake_properties_typeProperties_url')]"
					},
					"LS_Databricks_RetailLake_properties_typeProperties_existingClusterId": {
						"value": "[parameters('LS_Databricks_RetailLake_properties_typeProperties_existingClusterId')]"
					},
					"LS_SFTP_POSSource_properties_typeProperties_host": {
						"value": "[parameters('LS_SFTP_POSSource_properties_typeProperties_host')]"
					},
					"LS_SFTP_POSSource_properties_typeProperties_hostKeyFingerprint": {
						"value": "[parameters('LS_SFTP_POSSource_properties_typeProperties_hostKeyFingerprint')]"
					},
					"LS_SFTP_POSSource_properties_typeProperties_userName": {
						"value": "[parameters('LS_SFTP_POSSource_properties_typeProperties_userName')]"
					}
				}
			},
			"dependsOn": []
		}
	]
}