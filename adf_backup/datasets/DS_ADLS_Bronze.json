{
    "name": "DS_ADLS_Bronze",
    "type": "Microsoft.DataFactory/factories/datasets",
    "properties": {
        "linkedServiceName": {
            "referenceName": "LS_ADLSGen2_RetailLake",
            "type": "LinkedServiceReference"
        },
        "parameters": {
            "sourceName": {
                "type": "string"
            },
            "loadDate": {
                "type": "string"
            }
        },
        "annotations": [],
        "type": "DelimitedText",
        "typeProperties": {
            "location": {
                "type": "AzureBlobFSLocation",
                "fileSystem": "retail-lake",
                "folderPath": {
                    "value": "@concat('bronze/', dataset().sourceName, '/', dataset().loadDate)",
                    "type": "Expression"
                }
            },
            "columnDelimiter": ",",
            "firstRowAsHeader": true
        }
    }
}
